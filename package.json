{
  "name": "@roboflow/inference-sdk",
  "version": "0.4.0",
  "description": "Run Roboflow Workflows on live video from the browser with Roboflow Cloud Streaming",
  "keywords": [
    "roboflow",
    "computer-vision",
    "cloud-streaming",
    "workflows",
    "webrtc",
    "inference",
    "object-detection"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "author": "Roboflow",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/roboflow/inference-sdk-js"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "vite": "^5.3.3",
    "vite-plugin-dts": "^3.7.2",
    "vitest": "^4.0.14"
  }
}
